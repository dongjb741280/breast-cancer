# LLM（LangChain Anthropic 侧）
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# 指南 RAG embedding（可选）
# 不配 OPENAI_API_KEY 时，自动退回 BM25 关键词检索（无需 embedding，可立即跑通）
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# 检索参数
GUIDE_RETRIEVER=auto        # auto | vector | bm25
GUIDE_TOP_K=6
