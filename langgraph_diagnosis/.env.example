# LLM（LangChain Anthropic 侧）
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# 指南 RAG embedding（本地中文向量模型，无需 API key；未装依赖或下载失败时自动退回 BM25）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com   # HuggingFace 国内镜像（模型下载用）
HF_HUB_DISABLE_XET=1                 # 关闭 xet 加速（国内网络下更稳）

# 检索参数
GUIDE_RETRIEVER=auto        # auto | vector | bm25
GUIDE_TOP_K=6
